# Required: Groq API key (free tier) for the LangChain diagnostic agent
# Get a key at https://console.groq.com — no card required
GROQ_API_KEY=

# LLM model used by the diagnostic agent
GROQ_MODEL=llama-3.3-70b-versatile

# MLflow tracking URI — defaults to a local sqlite-backed store.
# For Azure ML, set this to the Azure ML workspace tracking URI:
#   az ml workspace show -n <ws> -g <rg> --query mlflow_tracking_uri -o tsv
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT_NAME=ml-monitor

# Local SQLite store for drift/perf metrics history
METRICS_DB_URL=sqlite:///./data/metrics.db

# Drift thresholds
PSI_WARN_THRESHOLD=0.1
PSI_ALERT_THRESHOLD=0.25
PERF_DROP_ALERT=0.05

# GitHub Actions retraining hook (used when a drift alert fires)
# Create a fine-grained PAT with "actions: write" on the repo, then fill these
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW=retrain.yml
GITHUB_REF=main
GITHUB_TOKEN=

# Azure ML (optional, only needed for Azure deployment)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=
