# Required: Groq API key (free tier) for the LangChain diagnostic agent
# Get a key at https://console.groq.com — no card required
GROQ_API_KEY=

# LLM model used by the diagnostic agent
GROQ_MODEL=llama-3.3-70b-versatile

# MLflow tracking URI — defaults to a local sqlite-backed store.
# For Azure ML, set this to the Azure ML workspace tracking URI:
#   az ml workspace show -n <ws> -g <rg> --query mlflow_tracking_uri -o tsv
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT_NAME=ml-monitor

# Local SQLite store for drift/perf metrics history
METRICS_DB_URL=sqlite:///./data/metrics.db

# Data-drift (PSI) thresholds
PSI_WARN_THRESHOLD=0.1
PSI_ALERT_THRESHOLD=0.25
# Label-free prediction-distribution PSI thresholds (online concept-drift proxy)
PRED_DRIFT_WARN_THRESHOLD=0.1
PRED_DRIFT_ALERT_THRESHOLD=0.25
# Concept-drift (F1 drop vs baseline) threshold
PERF_DROP_ALERT=0.05

# Skip drift stats when the window has fewer samples than this (unreliable below)
MIN_SAMPLES_FOR_CHECK=100

# Simulated ground-truth label latency in days (0 = labels arrive instantly).
# Set >0 to model the real lag; concept drift is then scored only on the labelled slice.
LABEL_DELAY_DAYS=0

# Logging verbosity for the service and CLI scripts
LOG_LEVEL=INFO

# Retraining safety. The both-conditions gate is always enforced in code; these add a
# global kill-switch, a dry-run mode, and a minimum interval between dispatches.
RETRAIN_ENABLED=true
RETRAIN_DRY_RUN=false
RETRAIN_MIN_INTERVAL_MINUTES=60

# Optional shared-secret auth on state-changing endpoints (empty = open / localhost only)
MONITOR_API_KEY=

# Optional free outbound alerting on warn/alert (Slack or Discord incoming webhook)
ALERT_WEBHOOK_URL=

# GitHub Actions retraining hook (used when the gate allows a retrain)
# Create a fine-grained PAT with "actions: write" on the repo, then fill these
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW=retrain.yml
GITHUB_REF=main
GITHUB_TOKEN=

# Azure ML (optional, only needed for Azure deployment)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=
